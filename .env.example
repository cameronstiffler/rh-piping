# Gemini API
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3-pro-image-preview

# Vertex AI (optional)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=global

# Generation defaults (optional)
GEMINI_TEMPERATURE=0.2
GEMINI_SEED=
PIPING_REF_MAX=4
CUSHION_MASK_PASS=false
MODEL_MASK_PASS=true
SEGMENTATION_MASK_MODEL=gemini-2.5-flash
SEGMENTATION_RESPONSE_MIME_TYPE=application/json
SEGMENTATION_MAX_OUTPUT_TOKENS=16384

# SAM2 mask generation (HF Space)
SAM2_SPACE=lightly-ai/SAMv2-Mask-Generator
SAM2_MODEL=large
SAM2_LOCAL_MODEL=facebook/sam2.1-hiera-large
SAM2_TARGET=piping
SAM2_VERTEX_ENDPOINT=projects/your_project/locations/us-central1/endpoints/sam2_hiera_l
SAM2_VERTEX_LOCATION=us-central1
