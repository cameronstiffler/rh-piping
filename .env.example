# Gemini API
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=models/gemini-3-pro-image-preview
SEED=124
TEMPERATURE=0.15
REPO=https://github.com/cameronstiffler/rh-background

# Vertex AI (optional)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=global

# Generation defaults (optional)
GEMINI_TEMPERATURE=0.15
GEMINI_SEED=
RESOLUTION=4K
GEMINI_IMAGE_SIZE=4K
GEMINI_ASPECT_RATIO=21:9
IMAGE_OUTPUT_MIME_TYPE=image/png
CHROMA_KEY_HEX=
CHROMA_KEY_TOLERANCE=30
CHROMA_KEY_SOFTNESS=0
CHROMA_KEY_MASK_DONOR=true
CHROMA_KEY_MASK_THRESHOLD=8
CHROMA_KEY_MASK_EXPAND=2
PIPING_REF_MAX=4
MODEL_MASK_PASS=true
MODEL_MASK_RATIO_TOL=0.01
# Post-mask generation is disabled in this repo. Do not enable it.
POST_MASK_PASS=false
SEGMENTATION_MASK_MODEL=gemini-2.5-flash
SEGMENTATION_RESPONSE_MIME_TYPE=application/json
SEGMENTATION_MAX_OUTPUT_TOKENS=16384

# Donor piping mask controls where piping gets composited.
DONOR_PIPING_MASK_PROMPT=
DONOR_PIPING_MASK_THRESHOLD=200
DONOR_PIPING_MASK_EXPAND=2
DONOR_PIPING_MASK_BLUR=0.0

# Edit mask controls (optional). Keep tight so the model recolors in-place.
EDIT_MASK_ERODE=0
EDIT_MASK_BLUR_RADIUS=0.0

# Preview background (optional; creates a *_preview.png next to the final output)
PREVIEW_BG_HEX=

FORCE_SWATCH_FALLBACK=false
ENFORCE_ADOBE_RGB=false
ADOBE_RGB_ICC=/System/Library/ColorSync/Profiles/AdobeRGB1998.icc
ENFORCE_DPI=true
TARGET_DPI=300
MASK_BLUR_RADIUS=2
CUSHION_MASK_PASS=false
MODEL_MASK_THRESHOLD=200
VERTEX_BG_MODEL=imagen-3.0-capability-001
VERTEX_BG_LOCATION=us-central1
#MAX_SIDE=4096

# Copy latest result after each run (overwrites latest.png)
LATEST_RESULT_DIR=

# Optional: pipe-path QA scoring (does not affect masking/editing).
PIPE_PATH_PNG=
PIPE_PATH_RGB=255,73,73
PIPE_PATH_COLOR_TOL=40
PIPE_PATH_EXPAND=8
PIPE_PATH_CHANGE_THRESHOLD=8

# Composite edge controls (optional; defaults preserve prior behavior)
# - Erode shrinks the composite mask to reduce halo/bleed.
# - Feather blurs the composite mask edge for a softer, more photoreal transition.
COMPOSITE_MASK_ERODE=0
COMPOSITE_MASK_FEATHER=0.0
